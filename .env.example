# Copy this file to .env and fill in your own value. Never commit .env.
#   cp .env.example .env

# Required: Portkey API key used for every agent (model gpt-6-luna).
PORTKEY_API_KEY=

# Optional overrides (defaults shown in comments; leave blank to use them).
# Portkey gateway URL. Default: https://api.portkey.ai/v1
PORTKEY_BASE_URL=
# Value of the x-portkey-provider header. Default: openai
PORTKEY_PROVIDER=
# Comma-separated browser origins allowed by the backend CORS policy.
# Default: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=
